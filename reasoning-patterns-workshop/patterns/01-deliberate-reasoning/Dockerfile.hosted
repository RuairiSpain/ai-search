# Hosted-agent image for the pattern-01 custom loop. Build context = repo root
# so common/ is included. Foundry runs this with managed identity + tracing.
FROM python:3.12-slim
WORKDIR /app
COPY common/ common/
COPY patterns/01-deliberate-reasoning/ patterns/01-deliberate-reasoning/
RUN pip install --no-cache-dir -r common/reasoning_common/requirements.txt
ENV PYTHONPATH=/app/common
WORKDIR /app/patterns/01-deliberate-reasoning
CMD ["python", "src/workflow.py"]
