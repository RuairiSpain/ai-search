# --- Translation model (Microsoft Foundry / Azure OpenAI via agent-framework) ---
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=

# Set to "1" to use the offline stub translator (no model calls). Useful for local demo/tests.
LDA_USE_STUB_TRANSLATOR=1

# --- Storage backend ---
# "local" writes artifacts under LDA_LOCAL_STORAGE_ROOT instead of Azure Blob Storage.
# Use this for local demo runs. Set to "azure" for a real private storage account.
LDA_STORAGE_BACKEND=local
LDA_LOCAL_STORAGE_ROOT=.data/blob-store

# Azure Blob Storage (private endpoint, public network access disabled).
# Auth is via Managed Identity / AzureCliCredential (azure-identity) - no account keys.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=artifacts

# --- Metadata + orchestration state store (SQLite for the demo) ---
LDA_STATE_DB_PATH=.data/state.db

# --- Artifact policy ---
LDA_ARTIFACT_TTL_HOURS=24
LDA_DOWNLOAD_TOKEN_TTL_MINUTES=15
LDA_MAX_INPUT_CHARS=1000000
LDA_MAX_MARKDOWN_BYTES=5242880

# HMAC signing secret for broker download tokens. Generate with: openssl rand -hex 32
# In production, load this from Key Vault - never commit a real value.
LDA_BROKER_SIGNING_KEY=dev-only-change-me

# Public base URL of the Artifact Broker API, used to build the link sent to chat UI.
LDA_BROKER_BASE_URL=http://localhost:8081

# --- Caller identity (Entra) ---
# "dev" trusts an X-Debug-User header (local only). "entra" validates a bearer JWT.
LDA_IDENTITY_MODE=dev
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
