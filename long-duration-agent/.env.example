# --- Translation model (Microsoft Foundry / Azure OpenAI via agent-framework) ---
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=

# Set to "1" to use the offline stub translator (no model calls). Useful for local demo/tests.
LDA_USE_STUB_TRANSLATOR=1

# --- Hosted agent local scratch workspace ($HOME/artifacts equivalent) ---
# Temporary only - deleted once the durable copy is uploaded. See workspace.py.
LDA_WORKSPACE_ROOT=.data/workspace

# --- Storage backend ---
# "local"   - writes artifacts under LDA_LOCAL_STORAGE_ROOT. No dependencies, fastest option.
# "azurite" - talks to a locally running Azurite emulator via the real azure-storage-blob SDK.
#             Closer to production than "local": exercises the actual Blob REST API client,
#             including real SAS generation. Run Azurite first, e.g.:
#             docker run -p 10000:10000 mcr.microsoft.com/azure-storage/azurite
#             or: npx azurite-blob --blobHost 0.0.0.0
# "azure"   - a real, public-network storage account gated by SAS, not anonymous access
#             (see infra/storage-public.bicep and "Public storage + SAS" in docs/architecture.md).
LDA_STORAGE_BACKEND=local
LDA_LOCAL_STORAGE_ROOT=.data/blob-store

# Only used when any *_BACKEND setting is "azurite". Defaults to Azurite's published,
# well-known emulator connection string (127.0.0.1:10000/10001/10002) - override only if
# your Azurite instance runs on a different host/port.
# AZURITE_CONNECTION_STRING=

# Azure Blob Storage - public network access, SAS-gated (not anonymous). Auth is via Managed
# Identity (azure-identity) - no account keys; the identity needs "Storage Blob Data
# Contributor" (upload/delete) and "Storage Blob Delegator" (mint the SAS-signing User
# Delegation Key) - both wired up by infra/storage-public.bicep.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=artifacts

# --- Distributed checkpoint + metadata backends (multi-instance only) ---
# "file"/"sqlite" (default) - single host's local disk, fine for a demo/single instance.
# "azurite"/"azure" - Azure Table Storage, required once more than one hosted-agent replica
#                      needs to see the same in-flight operations. See docs/architecture.md.
LDA_CHECKPOINT_BACKEND=file
LDA_CHECKPOINT_TABLE_NAME=workflowcheckpoints
LDA_METADATA_BACKEND=sqlite
LDA_OPERATIONS_TABLE_NAME=operations
LDA_ARTIFACTS_TABLE_NAME=artifacts
LDA_STEERING_TABLE_NAME=steeringmessages
# Durable, replayable per-operation event log - every SSE event is persisted here as it's
# emitted, so a client that reconnects to a still-running operation gets the full history
# replayed before live events resume. See "Reconnecting mid-run" in docs/architecture.md.
LDA_EVENTS_TABLE_NAME=operationevents
# Required when either backend above is "azure". e.g. https://<account>.table.core.windows.net
AZURE_TABLE_ACCOUNT_URL=

# --- Metadata + orchestration state store (SQLite backend only) ---
LDA_STATE_DB_PATH=.data/state.db

# --- Stale-operation sweep (stale_operations.py) ---
# An operation stuck in_progress/waiting_hitl past this many hours is force-stopped.
LDA_OPERATION_STALE_HOURS=6

# --- Key Vault (secrets.py) ---
# When set, the Content Safety API key below is fetched from Key Vault instead, cached for
# LDA_KEY_VAULT_CACHE_SECONDS.
LDA_KEY_VAULT_URL=
LDA_KEY_VAULT_CONTENT_SAFETY_KEY_SECRET_NAME=lda-content-safety-api-key
LDA_KEY_VAULT_CACHE_SECONDS=3600

# --- Observability (observability.py) ---
# "none" (default) | "console" (local debugging) | "otlp" (export to a collector/Azure Monitor)
LDA_OTEL_EXPORTER=none
LDA_OTEL_ENDPOINT=
LDA_SERVICE_NAME=long-duration-agent
LDA_METRICS_ENABLED=1

# --- Artifact policy ---
LDA_ARTIFACT_TTL_HOURS=24
LDA_MAX_INPUT_CHARS=1000000
LDA_MAX_MARKDOWN_BYTES=5242880

# Real, signed Azure Blob SAS URL TTL - minted directly by generate_download_url(), no broker.
# Keep this short: anyone holding the link can use it until it expires, with no server-side
# re-check on each download. See "Public storage + SAS" in docs/architecture.md.
LDA_DOWNLOAD_SAS_TTL_MINUTES=15

# --- Rate limiting (rate_limit.py) ---
# Caps genuinely new POST /invocations per caller (never a resumed operation_id). 0 disables.
LDA_RATE_LIMIT_ENABLED=1
LDA_RATE_LIMIT_INVOCATIONS_PER_MINUTE=30

# --- Content safety guardrail (content_safety.py) ---
# "off" (default) | "blocklist" (offline substring match) | "azure" (Azure AI Content Safety)
LDA_CONTENT_SAFETY_MODE=off
LDA_CONTENT_SAFETY_BLOCKLIST=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=
LDA_CONTENT_SAFETY_MAX_SEVERITY=4

# --- Caller identity (Entra) ---
# "dev" trusts an X-Debug-User header (local only). "entra" validates a bearer JWT.
LDA_IDENTITY_MODE=dev
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
# Recommended true in production - see docs/architecture.md's "Entra token hardening".
ENTRA_REQUIRE_ISSUER_MATCH=1
ENTRA_REQUIRED_SCOPE=
ENTRA_REQUIRED_ROLE=
