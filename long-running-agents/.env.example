# Copy to .env for local development. Never commit the real .env.
# In Azure, these are set as Container App environment variables / secrets
# by infra/main.bicep — see infra/config/variables.bicepparam.

# --- Gateway auth (validating inbound chat-client tokens) ---
GATEWAY_TENANT_ID=00000000-0000-0000-0000-000000000000
GATEWAY_CONFIG_PATH=config/apps.yaml

# --- Foundry ---
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project

# --- Postgres (gateway's own state: gw_context, gw_task, gw_event, ...) ---
# Local dev (docker-compose): plain password auth.
# In Azure: PGHOST/PGDATABASE/PGUSER are set by Bicep outputs; the password
# is never set — the app acquires an Entra token at connect time instead
# (see src/gateway/store/db.py and docs/03-postgres-schema.md "Azure
# Postgres with Entra auth").
PGHOST=localhost
PGPORT=5432
PGDATABASE=gateway
PGUSER=gateway
PGPASSWORD=devpassword
PG_USE_ENTRA_AUTH=false

# --- Artifacts blob storage ---
ARTIFACTS_STORAGE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
ARTIFACTS_CONTAINER=artifacts

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

LOG_LEVEL=info
