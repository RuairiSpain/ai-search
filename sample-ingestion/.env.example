# Default environment values for the Azure AI Search integrated vectorisation lab.
# These are safe placeholders. Replace endpoint, connection string and keys before running Azure-backed exercises.

# Azure AI Search
SEARCH_ENDPOINT=https://REPLACE-WITH-YOUR-SEARCH-SERVICE.search.windows.net
SEARCH_INDEX_NAME=rag-documents-index-integrated
SEARCH_API_KEY=
SEARCH_API_VERSION=2026-04-01

# Azure OpenAI embeddings
AZURE_OPENAI_ENDPOINT=https://REPLACE-WITH-YOUR-AZURE-OPENAI.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Blob Storage for indexer input files
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=REPLACE;AccountKey=REPLACE;EndpointSuffix=core.windows.net
BLOB_CONTAINER_NAME=ai-search-raw-documents

# Optional OCR / Azure AI services settings
USE_OCR=false
AZURE_AI_SERVICES_ENDPOINT=https://REPLACE-WITH-YOUR-AI-SERVICES.cognitiveservices.azure.com
AZURE_AI_SERVICES_KEY=
